# ---------------------------------------------------------------------------
# Student Comprehensive League - environment configuration
# Copy this file to `.env` and adjust the values before starting the server.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public brand name shown in the topbar and page title
APP_NAME=لیگ جامع دانش‌آموزی

# Public origin used in payment callbacks and post-payment redirects.
# In production this MUST be the exact public URL (https://example.com), because
# Zarinpal sends the browser back to this host and the session cookie is bound to it.
APP_BASE_URL=http://localhost:3000

# Every self-registered teacher gets this many days of full access for free.
TRIAL_DAYS=14

# Site-owner panel. The default password only exists in development; in
# production ADMIN_PASSWORD is required before the admin account is created.
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-this-before-production
ADMIN_NAME=مدیر سامانه

# Subscription payments.
# `card` = manual card-to-card: the admin publishes the destination card in the
#          admin panel and reviews each teacher's receipt there.
# `mock` = local checkout, moves no money.
# `zarinpal` = official v4 REST API (amounts are sent in Rial).
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=card
# PAYMENT_PROVIDER=zarinpal
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Sandbox is useful before the merchant account is approved.
ZARINPAL_SANDBOX=false
# ZARINPAL_BASE_URL=https://payment.zarinpal.com
# ZARINPAL_TIMEOUT_MS=15000

# Absolute path to a PERSISTENT volume. The SQLite database and uploaded files
# live here, so it must survive redeploys (e.g. /var/lib/league on a VPS or the
# mounted volume path provided by your PaaS).
DATA_DIR=./data

# REQUIRED in production: at least 16 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Session behaviour: a login is valid for exactly 24 hours. The cookie is not
# refreshed by activity, so expiry is always measured from the login itself.
SESSION_COOKIE_NAME=scl.sid
SESSION_MAX_AGE_MS=86400000

# Set to true when the app runs behind a reverse proxy / PaaS load balancer so
# that secure cookies and client IPs are detected correctly.
TRUST_PROXY=false

# Timezone offset (minutes east of UTC) used for "today" and Jalali dates.
# Iran Standard Time is UTC+03:30.
APP_TZ_OFFSET_MINUTES=210

# Demo data for `npm run seed` and for the first boot of an empty dev database
SEED_ENABLED=true
SEED_TEACHER_USER=teacher
SEED_TEACHER_PASS=teacher1234
SEED_DEMO_PASS=student1234
# SEED_ON_BOOT=false

# First teacher account for an EMPTY database (enabled by default in production,
# where the demo seed never runs). Without it a fresh production database has no
# account and nobody can log in. Remove the password after the first login, or
# reset it later with `npm run bootstrap -- --force`.
# BOOTSTRAP_TEACHER=true
# BOOTSTRAP_TEACHER_USER=teacher
# BOOTSTRAP_TEACHER_PASS=a-long-password-for-the-first-teacher
# BOOTSTRAP_TEACHER_NAME=مدیر
# BOOTSTRAP_ALLOW_WEAK=false

# Rate limiting
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=1200
RATE_WINDOW_MS=900000

# Uploads and quotas
MAX_UPLOAD_BYTES=10485760
# Payment receipt images are capped separately (default 5 MB).
# MAX_RECEIPT_BYTES=5242880
LIKES_PER_DAY=10
BODY_LIMIT=512kb

# Logging: debug | info | warn | error
LOG_LEVEL=debug

# Groq AI (https://groq.com) for the Q&A assistant that drafts multiple-choice
# quizzes/questionnaires. `GROQ_API_KEY` is the shared default. A teacher can
# save a personal key in «سوال و پاسخ ← دستیار هوش مصنوعی»; the encrypted
# personal key takes precedence and an empty personal key falls back here.
# Without either key the assistant stays visible but cannot generate until a
# key is saved. The default model is openai/gpt-oss-20b.
# GROQ_API_KEY=gsk_your-groq-api-key
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_TIMEOUT_MS=45000
# GROQ_MAX_COMPLETION_TOKENS=4096

# SMS over sms.ir (https://sms.ir/rest-api/): daily parent reports plus the
# owner panel's test/bulk messages.
#
# Teachers normally enter their own API key and sender line in
# «گزارش روزانه ← تنظیمات پیامک من» inside their panel. Those encrypted values
# take precedence for that teacher's reports. The variables below are an
# optional server-wide fallback for teachers who have not configured their own
# account; without either source, rows stay queued in the local outbox and are
# never lost.
# SMS_ENABLED=false
# SMSIR_API_KEY=your-sms-ir-api-key
# SMSIR_LINE_NUMBER=3000xxxxxx
# SMSIR_BASE_URL=https://api.sms.ir
# SMS_TIMEOUT_MS=15000

# Directory used by `npm run backup` (defaults to $DATA_DIR/backups)
# BACKUP_DIR=/var/backups/league

# ---------------------------------------------------------------------------
# Automatic off-site backup to GitHub (recommended on any PaaS whose container
# filesystem is recreated on redeploy).
#
# 1. Create a PRIVATE repository, e.g. https://github.com/<you>/league-backups
# 2. Create a fine-grained token with "Contents: Read and write" on that repo
#    (GitHub → Settings → Developer settings → Personal access tokens).
# 3. Set the variables below and restart. `npm run backup:status` shows what is
#    stored remotely; `npm run backup:github` uploads a snapshot immediately.
#
# The snapshot holds student data, so a public repository is refused unless
# BACKUP_GITHUB_ALLOW_PUBLIC=true.
# ---------------------------------------------------------------------------
BACKUP_GITHUB_ENABLED=false
# BACKUP_GITHUB_REPO=Asgh24/league-backups
# BACKUP_GITHUB_TOKEN=github_pat_xxx
# Branch and directory that hold the snapshots
BACKUP_GITHUB_BRANCH=main
BACKUP_GITHUB_DIR=db-backups
BACKUP_GITHUB_FILE_PREFIX=league
# How often a snapshot is uploaded (minutes). Default: once a day.
BACKUP_GITHUB_INTERVAL_MINUTES=1440
# Delete all but the newest N snapshots (0 keeps every snapshot)
BACKUP_GITHUB_KEEP=7
# Wait before the first upload after boot, and refuse snapshots above this size
BACKUP_GITHUB_START_DELAY_MS=60000
BACKUP_GITHUB_MAX_MB=50
# On boot, replace an EMPTY local database with the newest snapshot
RESTORE_FROM_GITHUB_ON_EMPTY_LOCAL=true
BACKUP_GITHUB_ALLOW_PUBLIC=false
# Only for tests or a GitHub Enterprise instance
# BACKUP_GITHUB_API_URL=https://api.github.com
# BACKUP_GITHUB_STATE_FILE=/data/backup-state.json
