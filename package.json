    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "chart.js": "^4.5.1",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
